# ============================================================
#  REDIRECTS — Rutas limpias sin extensión
# ============================================================

# 1️⃣ MAPA INTERACTIVO
# -------------------
# Primero redirigimos .html → /mapainteractivo (URL canónica)
/mapainteractivo.html   /mapainteractivo     301
# Luego servimos el HTML internamente cuando piden la URL limpia
/mapainteractivo        /mapainteractivo.html   200
# Por si ponen barra al final
/mapainteractivo/       /mapainteractivo     301


# 2️⃣ REDIRIGIR .php a la raíz
# ---------------------------
/index.php         /                 301
/*.php             /                 301


# 3️⃣ REDIRIGIR .html de share a la versión sin extensión
# -------------------------------------------------------
/share/ruta/*.html /share/ruta/:splat 301
/share/post/*.html /share/post/:splat 301
/share/m/*.html    /share/m/:splat    301


# 4️⃣ REDIRIGIR /index.html a la raíz
# ----------------------------------
/index.html        /                 301
/admin.html        /admin.html       200


# 5️⃣ FALLBACK 404 (SIEMPRE AL FINAL)
# ----------------------------------
# Si nada de arriba matchea, servimos 404.html con status 404
/*  /404.html  404
