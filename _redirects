# ============================================================
#  REDIRECTS — Cloudflare Pages
#
#  ESTRATEGIA:
#   - Las URLs limpias funcionan (rewrite 200 → .html)
#   - Las URLs con .html siguen funcionando (sin redirect)
#     ⚠️ NO redirigimos .html → limpia porque crea bucle
#     con los rewrites 200 que sirven el mismo .html
# ============================================================

# ─────────────────────────────────────────────────────────────
#  REWRITES 200: URL limpia → sirve el .html internamente
# ─────────────────────────────────────────────────────────────

# Mapa interactivo
/mapainteractivo        /mapainteractivo.html   200

# Admin
/admin                  /admin.html             200

# Share / Ruta
/share/ruta/:splat      /share/ruta/:splat.html 200

# Share / Post
/share/post/:splat      /share/post/:splat.html 200

# Share / Market
/share/m/:splat         /share/m/:splat.html    200

# ─────────────────────────────────────────────────────────────
#  REDIRIGIR .php
# ─────────────────────────────────────────────────────────────
/index.php              /                       301
/*.php                   /                       301

# ─────────────────────────────────────────────────────────────
#  REDIRIGIR /index.html a la raíz
# ─────────────────────────────────────────────────────────────
/index.html             /                       301

# ─────────────────────────────────────────────────────────────
#  FALLBACK 404 (SIEMPRE AL FINAL)
# ─────────────────────────────────────────────────────────────
/*                      /404.html               404
